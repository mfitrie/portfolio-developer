---
import { Button } from "@/components/ui/button";
import Layout from "../../layouts/Layout.astro";
import { getCollection } from "astro:content";
import { Icon } from "@iconify/react";
import { ArrowLeft } from "lucide-react";
const host = Astro.url.host;

const posts = (await getCollection("blog"))
    .filter((post) => !post.data.draft)
    .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<Layout title="Blog">
    <div class="mx-auto max-w-2xl px-6 py-16">
        <div class="flex flex-row items-center gap-3 mb-4">
            <a href="/">
                <Button className="cursor-pointer" variant="ghost" size="icon">
                    <ArrowLeft />
                </Button>
            </a>
            <h1 class="font-mono text-2xl font-semibold tracking-tight">
                Posts
            </h1>
        </div>

        <div class="border-t border-border">
            {
                posts.map((post) => (
                    <a
                        href={`/blog/${post.id}/`}
                        class="grid grid-cols-[auto_1fr_auto_auto] items-baseline gap-4 border-b border-border px-1 py-4 font-mono text-sm transition-colors hover:bg-accent"
                    >
                        <span
                            class="h-2 w-2 rounded-full bg-emerald-500"
                            title="published"
                        />
                        <span class="font-medium text-foreground">
                            {post.data.title}
                        </span>
                        <span class="text-xs text-muted-foreground">
                            {post.data.tags?.map((t) => `#${t}`).join(" ")}
                        </span>
                        <span class="text-xs text-muted-foreground">
                            {post.data.pubDate.toISOString().slice(0, 10)}
                        </span>
                    </a>
                ))
            }
        </div>
    </div>
</Layout>
