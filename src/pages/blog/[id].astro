---
import { Button } from "@/components/ui/button";
import Layout from "../../layouts/Layout.astro";
import { getCollection, render } from "astro:content";
import { ArrowLeft } from "lucide-react";

export async function getStaticPaths() {
    const posts = await getCollection("blog");
    return posts.map((post) => ({
        params: { id: post.id },
        props: { post },
    }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<Layout title={post.data.title}>
    <div class="mx-auto max-w-2xl px-6 py-16">
        <div class="flex flex-row items-center gap-3 mb-4">
            <div>
                <a href="/blog/">
                    <Button className="cursor-pointer" variant="ghost" size="icon">
                        <ArrowLeft />
                    </Button>
                </a>
            </div>
            <div>
                <h1
                    class="font-mono text-2xl font-semibold tracking-tight"
                >
                    {post.data.title}
                </h1>
            </div>
        </div>

        <div
            class="mb-10 flex gap-4 border-b border-border pb-6 font-mono text-xs text-muted-foreground"
        >
            <span>{post.data.pubDate.toISOString().slice(0, 10)}</span>
            {post.data.tags?.map((t) => <span>#{t}</span>)}
        </div>

        <article class="prose prose-neutral dark:prose-invert max-w-none">
            <Content />
        </article>
    </div>
</Layout>
