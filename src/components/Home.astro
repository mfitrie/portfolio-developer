---
import { listExternalLinks, allSkills, listExperience, listProject } from "@/stores/data";
import { Button } from "../components/ui/button";
import { Separator } from "../components/ui/separator";
import { Icon } from "@iconify/react";
---

<div id="home" class="flex flex-col items-center h-screen pt-32">
    <div class="flex flex-col gap-10">
        <div class="flex flex-col gap-5">
            <!-- //TODO: add animation icon or blender -->
            <div>
                <span class="text-primary text-sm"
                    >AVAILABLE FOR SELECT PROJECTS</span
                >
            </div>
            <div>
                <span class="text-2xl"
                    >I build a system to solve business problem</span
                >
            </div>
            <div>
                <span class="text-sm text-muted-foreground">
                    A developer who works across the entire application stack:
                    frontend (UI/UX, what users see and interact with) and
                    backend (server logic, databases, APIs, and infrastructure).
                    I'm not limited to one layer, and I can build a complete
                    product end to end.
                </span>
            </div>
            <div class="flex flex-row gap-2">
                <a
                    href={listExternalLinks[1].link}
                    target="_blank"
                    rel="noopener noreferrer"
                >
                    <Button variant="outline">
                        <div class="flex flex-row items-center gap-1">
                            <Icon client:visible icon="mdi:github" />
                            <span>GitHub</span>
                        </div>
                    </Button>
                </a>
                <a
                    href={listExternalLinks[0].link}
                    target="_blank"
                    rel="noopener noreferrer"
                >
                    <Button>
                        <div class="flex flex-row items-center gap-1">
                            <Icon client:visible icon="mdi:linkedin" />
                            <span>Linkedin</span>
                        </div>
                    </Button>
                </a>
            </div>
        </div>

        <Separator />

        <div class="flex flex-row justify-between">
            <div class="flex flex-col gap-1">
                <span class="text-3xl">{listExperience.length}+</span>
                <span class="text-sm text-muted-foreground">Experience</span>
            </div>
            <div class="flex flex-col gap-1">
                <span class="text-3xl">{listProject.length}+</span>
                <span class="text-sm text-muted-foreground"
                    >Project Delivered</span
                >
            </div>
            <div class="flex flex-col gap-1">
                <span class="text-3xl">{allSkills.length}+</span>
                <span class="text-sm text-muted-foreground"
                    >Technologies Mastered</span
                >
            </div>
        </div>
    </div>
</div>
