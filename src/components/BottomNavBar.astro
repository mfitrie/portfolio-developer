<nav class="fixed bottom-4 left-1/2 -translate-x-1/2 z-50">
    <div
        class="flex items-center gap-1 rounded-full border bg-background/80 backdrop-blur-md shadow-lg px-4 py-2"
    >
        <a
            href="/"
            class="px-3 py-2 rounded-full text-sm hover:bg-muted transition-colors"
        >
            Home
        </a>
        <a
            href="/projects"
            class="px-3 py-2 rounded-full text-sm hover:bg-muted transition-colors"
        >
            Projects
        </a>
        <a
            href="/about"
            class="px-3 py-2 rounded-full text-sm hover:bg-muted transition-colors"
        >
            About
        </a>
        <a
            href="/contact"
            class="px-3 py-2 rounded-full text-sm hover:bg-muted transition-colors"
        >
            Contact
        </a>

        <div class="w-px h-5 bg-border mx-1"></div>

        <button
            id="theme-toggle"
            aria-label="Toggle dark mode"
            class="flex items-center justify-center w-8 h-8 rounded-full hover:bg-muted transition-colors"
        >
            <!-- Sun icon (shown in dark mode, click to go light) -->
            <svg
                id="icon-sun"
                xmlns="http://www.w3.org/2000/svg"
                width="16"
                height="16"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="hidden"
            >
                <circle cx="12" cy="12" r="4"></circle>
                <path
                    d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"
                ></path>
            </svg>
            <!-- Moon icon (shown in light mode, click to go dark) -->
            <svg
                id="icon-moon"
                xmlns="http://www.w3.org/2000/svg"
                width="16"
                height="16"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
            >
                <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"
                ></path>
            </svg>
        </button>
    </div>
</nav>
<script is:inline>
    const btn = document.getElementById("theme-toggle");
    const sunIcon = document.getElementById("icon-sun");
    const moonIcon = document.getElementById("icon-moon");

    function updateIcons() {
        const isDark = document.documentElement.classList.contains("dark");
        sunIcon.classList.toggle("hidden", !isDark);
        moonIcon.classList.toggle("hidden", isDark);
    }

    btn.addEventListener("click", () => {
        const isDark = document.documentElement.classList.toggle("dark");
        localStorage.setItem("theme", isDark ? "dark" : "light");
        updateIcons();
    });

    updateIcons();
</script>
