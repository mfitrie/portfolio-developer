---
import {
    Card,
    CardAction,
    CardContent,
    CardDescription,
    CardFooter,
    CardHeader,
    CardTitle,
} from "./ui/card";
import { Badge } from "./ui/badge";
import { listProject } from "@/stores/data";
---

<div
    id="project"
    class="flex flex-col justify-center min-h-screen"
>
    <div class="flex flex-col gap-4">
        <div>
            <span class="text-primary text-sm">SELECTED WORK</span>
        </div>
        <div>
            <span class="text-2xl">Projects</span>
        </div>
        <div>
            <span class="text-muted-foreground"
                >High-impact applications built with precision and care</span
            >
        </div>
        <div class="flex flex-col gap-4">
            {
                listProject.map((item) => {
                    return (
                        <Card>
                            <CardHeader>
                                <CardTitle>{item.title}</CardTitle>
                                <CardDescription>{item.title_description}</CardDescription>
                            </CardHeader>
                            <CardContent>
                                <div class="flex flex-col gap-2">
                                    <p>{item.description}</p>
                                    <div class="flex flex-row items-center gap-2">
                                        {
                                            item.skills.map(itemInside => (
                                                <Badge variant={"outline"}>{itemInside}</Badge>
                                            ))
                                        }
                                    </div>
                                </div>
                            </CardContent>
                            <CardFooter>
                                <a href={item.website_link}>Visit Website</a>
                            </CardFooter>
                        </Card>
                    );
                })
            }
        </div>
    </div>
</div>
