---
import {
    Card,
    CardAction,
    CardContent,
    CardDescription,
    CardFooter,
    CardHeader,
    CardTitle,
} from "./ui/card";
import { Badge } from "./ui/badge";
import { listProject } from "@/stores/data";
import { BadgeCustomColors } from "./ui/custom-badge";
import { Button } from "./ui/button";
import { ExternalLink } from "lucide-react";
---

<div id="project" class="flex flex-col pt-5 min-h-screen">
    <div class="flex flex-col gap-4">
        <div>
            <span class="text-primary text-sm">SELECTED WORK</span>
        </div>
        <div>
            <span class="text-2xl">Projects</span>
        </div>
        <div>
            <span class="text-muted-foreground"
                >High-impact applications built with precision and care</span
            >
        </div>
        <div class="flex flex-col gap-4">
            {
                listProject.map((item) => {
                    return (
                        <Card>
                            <CardHeader>
                                <CardTitle>{item.title}</CardTitle>
                                <CardDescription>
                                    {item.title_description}
                                </CardDescription>
                            </CardHeader>
                            <CardContent>
                                <div class="flex flex-col gap-2">
                                    <p>{item.description}</p>
                                    <div class="flex flex-row items-center gap-2">
                                        {item.skills.map(
                                            (itemInside, indexInside) => (
                                                <BadgeCustomColors
                                                    color="indigo"
                                                    text={itemInside}
                                                />
                                            ),
                                        )}
                                    </div>
                                </div>
                            </CardContent>
                            {item.blog_link && (
                                <CardFooter>
                                    <a
                                        href={item.blog_link}
                                    >
                                        <Button className="cursor-pointer" variant="outline">
                                            <div class="flex flex-row items-center gap-2">
                                                <span>Read Blog</span>
                                                <ExternalLink />
                                            </div>
                                        </Button>
                                    </a>
                                </CardFooter>
                            )}
                            {item.website_link && (
                                <CardFooter>
                                    <a
                                        href={item.website_link}
                                        target="_blank"
                                        rel="noopener noreferrer"
                                    >
                                        <Button className="cursor-pointer" variant="outline">
                                            <div class="flex flex-row items-center gap-2">
                                                <span>Visit Website</span>
                                                <ExternalLink />
                                            </div>
                                        </Button>
                                    </a>
                                </CardFooter>
                            )}
                        </Card>
                    );
                })
            }
        </div>
    </div>
</div>
