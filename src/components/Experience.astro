---
import ExperienceTimeline from "./tsx/ExperienceTimeline"
---

<div
    id="experience"
    class="flex flex-col justify-center min-h-screen"
>
    <div class="flex flex-col gap-4">
        <div>
            <span class="text-primary text-sm">CAREER PATH</span>
        </div>
        <div>
            <span class="text-2xl">Experience</span>
        </div>
        <div>
            <span class="text-muted-foreground"
                >Progressive growth from junior to technical leadership</span
            >
        </div>
        <div>
            <ExperienceTimeline client:visible/>
        </div>
    </div>
</div>
